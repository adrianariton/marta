Bootstrap: docker
From: pytorch/pytorch:2.2.0-cuda11.8-cudnn8-runtime

%files
    requirements.txt /opt/requirements.txt

%post
    set -ex
    
    echo "[*] Update system"
    apt update -y && apt upgrade -y

    echo "[*] Install system dependencies"
    apt install -y python3-venv

    echo "[*] Upgrade pip"
    pip install --upgrade pip

    echo "[*] Install requirements (PyTorch already included)"
    # Remove torch packages from requirements before installing
    grep -v "^torch" /opt/requirements.txt > /tmp/requirements_no_torch.txt || true
    pip install -r /tmp/requirements_no_torch.txt

    echo "[*] Cleanup"
    rm /opt/requirements.txt /tmp/requirements_no_torch.txt

    echo "[*] Create entrypoint script"
    cat << 'EOF' > /entrypoint.sh
#!/bin/bash
exec "$@"
EOF

    chmod +x /entrypoint.sh
    
    echo "[*] Build completed successfully"

%environment
    export PATH="/opt/conda/bin:$PATH"

%runscript
    exec /entrypoint.sh "$@"